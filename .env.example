# Full service-key JSON from the BTP AI Core service binding.
# Get it from the ott-aicore-credentials secret on the control plane:
#   kubectl get secret ott-aicore-credentials -n crossplane-system \
#     --kubeconfig kubeconfig-live-controlplane.yaml \
#     -o jsonpath='{.data.attribute\.credentials}' | base64 -d
AICORE_CREDENTIALS=

# Deployment URL from the AI Core Deployment CR status (available once Deployment is Ready):
#   kubectl get deployment.aicore.crossplane.io ott-aicore-deployment \
#     --kubeconfig kubeconfig-live-controlplane.yaml \
#     -o jsonpath='{.status.atProvider.deploymentUrl}'
AICORE_DEPLOYMENT_URL=

# AI Core resource group (default is fine unless you created a custom one)
AICORE_RESOURCE_GROUP=default

PORT=3000
APP_TITLE=SAP AI Core Demo
